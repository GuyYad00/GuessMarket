<?xml version="1.0" encoding="UTF-8"?>
<!-- The official Exercise 1 schema, as published by the lecturer.
     Reproduced here from the copy on the course site so the sample files can
     actually be validated against it. Element and attribute names are kept
     exactly as published, including the "comision" spelling. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="id" type="xs:int"/>
	<xs:element name="description" type="xs:string"/>
	<xs:element name="comision">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:int">
					<xs:attribute name="type" use="required">
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="on-close"/>
								<xs:enumeration value="on-purchase"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="b" type="xs:int"/>
	<xs:element name="Guess-Market">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="GM-events"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="GM-options">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="GM-option" maxOccurs="2"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="GM-option" type="xs:string"/>
	<xs:element name="GM-method">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="GM-LMSR"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="GM-events">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="GM-event" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="GM-event">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="id"/>
				<xs:element ref="description"/>
				<xs:element ref="comision"/>
				<xs:element ref="GM-options"/>
				<xs:element ref="GM-method"/>
			</xs:sequence>
			<xs:attribute name="name" use="required">
				<xs:simpleType>
					<xs:list itemType="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="GM-LMSR">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="b"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
